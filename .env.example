# URL pública del sitio (se usa en metadata, Open Graph y sitemap)
NEXT_PUBLIC_SITE_URL=https://kaijucode.vercel.app

# Número de WhatsApp en formato internacional, sin "+" ni espacios. Ej: 5491112345678
NEXT_PUBLIC_WHATSAPP_NUMBER=5490000000000

# Formulario de contacto (Resend: https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# A dónde llegan las consultas (podés poner varias separadas por coma)
CONTACT_TO_EMAIL=tu-mail@gmail.com
# Remitente. Sin dominio verificado en Resend usá el de prueba (solo envía a tu propio mail de Resend).
CONTACT_FROM_EMAIL=Kaiju Code <onboarding@resend.dev>
